# Copy to .env and adjust. Every value can also be set directly in the
# environment; .env is a convenience, not a requirement.

# Required — Postgres connection string.
OZYMANDIS_DATABASE_URL=postgres://ozymandis:ozymandis@localhost:5432/ozymandis?sslmode=disable

# Listen address for the dashboard.
OZYMANDIS_ADDR=:8080

# Path to a kubeconfig. Leave unset to use the standard client-go loading
# rules (KUBECONFIG, then ~/.kube/config).
OZYMANDIS_KUBECONFIG=

# Set true when running inside the cluster with a mounted service account.
OZYMANDIS_KUBE_IN_CLUSTER=false

# Bearer token required on every request. Leaving this unset means the
# dashboard is UNAUTHENTICATED — acceptable on a laptop or a private network,
# not on anything reachable from the internet.
#   openssl rand -hex 24
OZYMANDIS_AUTH_TOKEN=

# The single owner every resource belongs to.
OZYMANDIS_OWNER_ID=owner-local
OZYMANDIS_OWNER_NAME=Local

OZYMANDIS_DEBUG=false

# Platform domain. Every app gets <name>.<this> as a hostname the moment it is
# created. Point a wildcard DNS RECORD (*.apps.example.com) at the cluster.
# Empty switches per-app hostnames off.
#
# The DNS record is a wildcard; the certificates are not. One record answers for
# every app name, and each name is then issued for individually. See
# OZYMANDIS_CERT_RESOLVER.
OZYMANDIS_APP_DOMAIN=

# Additional domain suffixes no tenant may claim, comma-separated.
# OZYMANDIS_APP_DOMAIN is always reserved whether or not it is listed here.
OZYMANDIS_RESERVED_DOMAINS=

# The ACME resolver every hostname's certificate is obtained from: the name of
# an entry in the ingress controller's own certificatesResolvers configuration,
# such as "letsencrypt". Defaults to "letsencrypt".
#
# One resolver serves everything — a platform subdomain and a domain somebody
# brought are issued for the same way, each certificate covering only the name
# it serves.
#
# READ THIS BEFORE RELYING ON THE DEFAULT. Ozymandis cannot check that a
# resolver by this name exists. Naming one that does not is not an error
# anywhere: the annotation is written, the Ingress is accepted, the deploy goes
# green, and the controller answers every request with its own built-in
# certificate. Visitors get a browser warning; nothing in Ozymandis, the
# dashboard, or the cluster reports a fault. The default value assumes a
# resolver called "letsencrypt" — which is a real assumption, not a safe one.
# install.sh installs no ingress controller at all (K3s with --disable traefik),
# so on a machine it set up there is nothing here to resolve against until you
# install a controller yourself.
#
# So: set this to the name your controller actually uses, or set it EMPTY.
# Empty serves every hostname over plain http, which is visibly wrong rather
# than invisibly wrong, and the dashboard says so on the domains page.
#
# There is no wildcard option and no cert-manager path. Serving one name under a
# certificate issued for another is what a browser reports as impersonation, so
# the only alternative offered to a real certificate is no TLS.
OZYMANDIS_CERT_RESOLVER=letsencrypt

# How long to wait for in-flight requests during graceful shutdown.
OZYMANDIS_SHUTDOWN_TIMEOUT=15s

# Public URL the dashboard is reached at. This is what a sign-in link is built
# from, and setting it is what switches accounts on: people, teams, invitations
# and session cookies instead of a single owner.
#
# Accounts stay off until it is set, because sign-in with no address to put in
# the link locks you out of your own dashboard with no way back.
OZYMANDIS_BASE_URL=

# SMTP relay for sign-in links, as host:port. Empty means no relay.
#
# With no relay and no Resend key, links are written to the log instead. That
# is deliberate: it is the only way back in when mail delivery breaks after
# accounts are switched on, and it is only safe because reading the log
# already implies host access.
OZYMANDIS_SMTP_ADDR=

# Relay credentials. Leave both empty for an unauthenticated relay; a password
# with no username is rejected at startup rather than sent anonymously.
OZYMANDIS_SMTP_USER=
OZYMANDIS_SMTP_PASSWORD=

# Envelope sender for relayed mail. Required whenever OZYMANDIS_SMTP_ADDR is set.
OZYMANDIS_SMTP_FROM=

# Resend's HTTP API instead of a relay, for a host with no SMTP to hand.
# Configuring both transports fails at startup rather than picking one.
OZYMANDIS_RESEND_API_KEY=
OZYMANDIS_RESEND_FROM=

# How long a signed-in browser stays signed in.
OZYMANDIS_SESSION_TTL=720h

# How long a sign-in link stays redeemable. Short on purpose: the link is a
# bearer credential sitting in a mailbox until it is used or expires.
OZYMANDIS_MAGIC_LINK_TTL=15m

# The address that may sign in to a fresh install before anybody has an
# account. Links are only ever sent to addresses that already exist, which is
# what stops the sign-in form filling the user table — and would otherwise
# leave a new install with accounts on impossible to enter. Only applies until
# that address has an account.
OZYMANDIS_OWNER_EMAIL=

# Seals secret environment variables before they are stored, so a database
# dump is useless without it. Generate with: openssl rand -base64 32
#
# Unset, variables still work but marking one secret is refused rather than
# stored readable. Losing this key means losing every secret sealed with it.
OZYMANDIS_SECRET_KEY=
