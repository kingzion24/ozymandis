package web

import "github.com/kingzion24/ozymandis/internal/web/ui/selectbox"

// TokensPage lists the API tokens the viewer holds in this team, and mints new
// ones.
//
// Note what is not here, and cannot be: the value of an existing token.
// account.APIToken has no field for one — only its hash was ever stored — so
// the table below can show what a credential is for and when it was last used
// without being able to show the credential. The one raw value that does appear
// arrives through TokensPageData.Issued, on the single response that created
// it, and is gone on the next render.
templ TokensPage(d TokensPageData) {
	@pageHead("Access tokens", d.TeamName, nil)
	if d.Error != "" {
		<div class="callout callout-err mb-5">
			<div class="min-w-0">{ d.Error }</div>
		</div>
	}
	if d.Issued != "" {
		<div class="panel mb-5">
			<div class="panel-header">
				<span class="panel-title">Your new token — { d.IssuedName }</span>
			</div>
			<div class="panel-body">
				<p class="mb-3 text-muted-foreground">
					Copy this now. It is shown once and is not recoverable: only its
					hash is stored, so nobody — including this dashboard — can read it
					back. Lose it and you revoke it and mint another.
				</p>
				<pre class="mono select-all break-all rounded border border-border bg-muted p-3 text-[13px]">{ d.Issued }</pre>
				<p class="mt-3 text-muted-foreground">
					Point the CLI at this install with:
				</p>
				<pre class="mono break-all rounded border border-border bg-muted p-3 text-[13px]">oz auth login --endpoint { d.BaseURL } --token { d.Issued }</pre>
			</div>
		</div>
	}
	<div class="panel mb-5">
		<div class="panel-header"><span class="panel-title">Your tokens</span></div>
		if len(d.Tokens) == 0 {
			<div class="panel-body">
				<p class="text-muted-foreground">
					You have no tokens in { d.TeamName }. Create one below to use
					<span class="mono">oz</span> against this install.
				</p>
			</div>
		} else {
			<div class="table-scroll">
			<table class="dtable min-w-[620px]">
				<thead>
					<tr><th>Name</th><th>Last used</th><th>Expires</th><th class="text-right">Actions</th></tr>
				</thead>
				<tbody>
					for _, t := range d.Tokens {
						<tr>
							<td><span class="mono">{ t.Name }</span></td>
							<td class="text-muted-foreground">{ tokenLastUsed(t) }</td>
							<td>
								if t.Expired() {
									@statusDot("expired", "tone-err")
								} else {
									<span class="text-muted-foreground">{ tokenExpiry(t) }</span>
								}
							</td>
							<td class="text-right">
								<form method="post" action={ templ.SafeURL("/settings/tokens/" + t.ID.String() + "/revoke") } class="inline">
									<button class="btn btn-sm btn-danger" type="submit">Revoke</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
			</div>
		}
	</div>
	<div class="panel mb-5">
		<div class="panel-header"><span class="panel-title">Create a token</span></div>
		<div class="panel-body">
			<p class="mb-4 text-muted-foreground">
				A token acts as <span class="mono">{ d.TeamName }</span> and carries the
				role you hold in it. It stops working the moment you leave the team.
			</p>
			<form method="post" action="/settings/tokens" class="flex flex-col gap-4 sm:flex-row sm:items-end">
				<div class="field grow">
					<label class="label" for="name">Name</label>
					<input
						class="control"
						id="name"
						name="name"
						type="text"
						required
						placeholder="ci, laptop, deploy-bot"
					/>
				</div>
				<div class="field">
					<label class="label" for="ttl_days">Expires</label>
					@selectbox.SelectBox() {
						@selectbox.Trigger(selectbox.TriggerProps{ID: "ttl_days", Name: "ttl_days"}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "No expiry"})
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
							for _, o := range tokenTTLs {
								@selectbox.Item(selectbox.ItemProps{
									Value: ttlValue(o.Days), Selected: o.Days == 0,
								}) {
									{ o.Label }
								}
							}
						}
					}
				</div>
				<button class="btn btn-primary" type="submit">Create token</button>
			</form>
		</div>
	</div>
}
