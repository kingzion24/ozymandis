package web

// SignInData is the state of the sign-in form.
//
// Username is echoed back so a mistyped password does not cost the name as
// well. The password never is: re-rendering it would put it in the HTML, and
// from there into any proxy log or browser cache that keeps the response.
//
// Error says what was refused and never why. "Incorrect username or password"
// is the whole vocabulary — a message that distinguished the two would turn
// this page into a way to discover which names exist.
type SignInData struct {
	Username string
	Error    string
}

templ SignIn(d SignInData) {
	@authCard("Sign in", "") {
		if d.Error != "" {
			<div class="callout callout-err mb-4">
				<div>{ d.Error }</div>
			</div>
		}
		<form method="post" action="/sign-in" class="flex flex-col gap-4">
			<div class="field">
				<label class="label" for="username">Username</label>
				<input
					class="control"
					id="username"
					name="username"
					type="text"
					autocapitalize="none"
					autocorrect="off"
					spellcheck="false"
					autocomplete="username"
					autofocus
					required
					value={ d.Username }
				/>
			</div>
			<div class="field">
				<label class="label" for="password">Password</label>
				<input
					class="control"
					id="password"
					name="password"
					type="password"
					autocomplete="current-password"
					required
				/>
			</div>
			<button class="btn btn-primary" type="submit">Sign in</button>
		</form>
	}
}

// authCard is the frame the signed-out pages share: centred, narrow, and
// without the chrome of a dashboard nobody has been let into yet.
templ authCard(title, subtitle string) {
	<div class="mx-auto w-full max-w-[380px] py-12">
		<div class="mb-5">
			<h1 class="text-[19px] font-semibold tracking-tight">{ title }</h1>
			if subtitle != "" {
				<p class="mt-1 text-[12.5px] text-muted-foreground">{ subtitle }</p>
			}
		</div>
		<div class="panel">
			<div class="panel-body">
				{ children... }
			</div>
		</div>
	</div>
}
